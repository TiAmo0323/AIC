*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
*.egg-info/
*.whl
*.webm
.coverage
htmlcov/
.venv/
venv/
env/

# Frontend dependencies and build output
node_modules/
dist/
.vite/
coverage/
.playwright-cli/

# Local configuration and credentials
.env
.env.*
!.env.example
*.local

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# API task outputs and runtime files
task_runs/
reports/
logs/
*.log
*.pid

